# Supabase → Project Settings → Database → Connection string
# Pooler (Transaction mode, port 6543) cho app runtime
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Direct (port 5432) cho drizzle-kit migrate
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Phase 3+: email
RESEND_API_KEY=""
EMAIL_FROM="Thiệp Bách Khoa <noreply@yourdomain.com>"
ADMIN_EMAIL=""
# Phase 5: Turnstile
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Ảnh thiệp: Cloudflare R2 (xem docs/STORAGE.md). Để trống thì tắt tính năng ảnh.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Phase 5: bảo vệ endpoint cron dọn thiệp hết hạn (Vercel tự gửi header này)
